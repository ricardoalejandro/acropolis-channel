{
    admin off
    skip_install_trust
    auto_https off
}

http://localhost:8080, http://127.0.0.1:8080 {
    redir https://localhost:17443{uri} 308
}

https://localhost:8443 {
    tls /local-pki/web/localhost.crt /local-pki/web/localhost.key
    reverse_proxy web:8080
}

https://127.0.0.1:8443 {
    tls /local-pki/web/localhost.crt /local-pki/web/localhost.key
    redir https://localhost:17443{uri} 308
}
