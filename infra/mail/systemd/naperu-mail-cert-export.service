[Unit]
Description=Export only the Naperu mail certificate after Traefik renewal
After=docker.service
[Service]
Type=oneshot
User=root
UMask=0077
ExecCondition=/usr/bin/test -f /root/proyect/naperu-mail/.local/public-started
ExecStart=/usr/bin/python3 /root/proyect/acropolis-channel/infra/mail/scripts/mail-ops.py export-cert
TimeoutStartSec=120
Nice=10
