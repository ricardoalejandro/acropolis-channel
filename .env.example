# Copy on the VPS only. Use separate random values and protect the file (chmod 600).
TRAEFIK_NETWORK=dokploy-network
DB_ADMIN_PASSWORD=replace_with_random_secret
DB_APP_PASSWORD=replace_with_different_random_secret
DB_MIGRATION_PASSWORD=replace_with_different_random_secret
# APP_IMAGE and MIGRATION_IMAGE are managed by the deployment script.
PUBLIC_VPS_IPV4=replace_with_server_public_ipv4

# Identity: configure SMTP privately, then prepare protector/trusted proxy addresses.
IDENTITY_PUBLIC_ORIGIN=https://acropolischannel.naperu.cloud
# Generated privately by: python3 scripts/identity-runtime.py --prepare
IDENTITY_KNOWN_PROXIES=
IDENTITY_DP_CERT_PASSWORD=
IDENTITY_SMTP_HOST=
IDENTITY_SMTP_PORT=587
IDENTITY_SMTP_SECURITY=starttls
IDENTITY_SMTP_USERNAME=
IDENTITY_SMTP_PASSWORD=
IDENTITY_SMTP_FROM_EMAIL=
IDENTITY_SMTP_FROM_NAME=Acrópolis Channel
